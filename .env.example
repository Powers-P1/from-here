# Copy to .env.local and set your key there. Never put a real key in this file.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_BASE_URL=https://api.anthropic.com/v1
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=180000
AI_TEXT_PROVIDER=anthropic
AI_TEXT_BASE_URL=https://api.anthropic.com/v1
AI_TEXT_MODEL=claude-sonnet-5-5
PORT=4176
# The optional Qwen/Gemma local profile is documented in docs/model-services.md.
